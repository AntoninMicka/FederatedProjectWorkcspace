{
  "name": "workspace-file-bridge",
  "displayName": "Workspace",
  "description": "Tasks, messages, documents and agent rules for Federated Workspace",
  "version": "0.4.3",
  "publisher": "federated-workspace",
  "license": "MPL-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "workspaceBridge.connect",
        "title": "Workspace: Připojit Workspace"
      },
      {
        "command": "workspaceBridge.sync",
        "title": "Workspace: Synchronizovat zprávy"
      },
      {
        "command": "workspaceBridge.open",
        "title": "Workspace: Otevřít komunikační soubory"
      },
      {
        "command": "workspaceBridge.message",
        "title": "Workspace: Odeslat výsledek nebo dotaz"
      },
      {
        "command": "workspaceBridge.disconnect",
        "title": "Workspace: Odpojit lokální bridge"
      },
      {
        "command": "workspaceBridge.configure",
        "title": "Workspace: Nastavení projektů"
      },
      {
        "command": "workspaceBridge.assign",
        "title": "Workspace: Přiřadit projekt v IDE"
      },
      {
        "command": "workspaceBridge.refreshPanel",
        "title": "Workspace: Obnovit panel",
        "icon": "$(refresh)"
      },
      {
        "command": "workspaceBridge.filterOpen",
        "title": "Workspace: Přepnout filtr otevřených úkolů",
        "icon": "$(filter)"
      },
      {
        "command": "workspaceBridge.allDocuments",
        "title": "Workspace: Zobrazit všechny podklady",
        "icon": "$(files)"
      },
      {
        "command": "workspaceBridge.compose",
        "title": "Workspace: Napsat zprávu nebo návrh",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "workspaceBridge.handoff",
        "title": "Workspace: Zkopírovat předání úkolu a pravidel",
        "icon": "$(copy)"
      },
      {
        "command": "workspaceBridge.showQueueTask",
        "title": "Workspace: Zobrazit položku fronty"
      },
      {
        "command": "workspaceBridge.queueHandoff",
        "title": "Workspace: Předat položku fronty agentovi"
      },
      {
        "command": "workspaceBridge.checkUpdates",
        "title": "Workspace: Zkontrolovat aktualizace rozšíření"
      }
    ],
    "configuration": {
      "title": "Workspace bridge",
      "properties": {
        "workspaceBridge.autoSync": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "Automaticky synchronizovat přiřazené projekty. Pro výběr propagovaných projektů spusťte **Workspace: Nastavení projektů**; pro změnu cíle **Workspace: Přiřadit projekt v IDE**."
        },
        "workspaceBridge.autoUpdate": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "Automaticky instalovat nové verze rozšíření z připojeného důvěryhodného backendu Workspace. Při vypnutí se aktualizace pouze nabídne. Obnovení okna vždy vyžaduje potvrzení."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workspaceBridge",
          "title": "Workspace",
          "icon": "workspace.svg"
        }
      ]
    },
    "views": {
      "workspaceBridge": [
        {
          "id": "workspaceBridge.tasks",
          "name": "Úkoly"
        },
        {
          "id": "workspaceBridge.messages",
          "name": "Zprávy"
        },
        {
          "id": "workspaceBridge.documents",
          "name": "Podklady"
        },
        {
          "id": "workspaceBridge.rules",
          "name": "Pravidla agentů"
        },
        {
          "id": "workspaceBridge.queue",
          "name": "Fronta úkolů"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "workspaceBridge.refreshPanel",
          "when": "view =~ /^workspaceBridge\\./",
          "group": "navigation@1"
        },
        {
          "command": "workspaceBridge.filterOpen",
          "when": "view == workspaceBridge.tasks",
          "group": "navigation@2"
        },
        {
          "command": "workspaceBridge.compose",
          "when": "view == workspaceBridge.messages",
          "group": "navigation@2"
        },
        {
          "command": "workspaceBridge.allDocuments",
          "when": "view == workspaceBridge.documents",
          "group": "navigation@2"
        },
        {
          "command": "workspaceBridge.configure",
          "when": "view == workspaceBridge.tasks",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "workspaceBridge.compose",
          "when": "view == workspaceBridge.tasks && viewItem == task",
          "group": "inline@1"
        },
        {
          "command": "workspaceBridge.handoff",
          "when": "view == workspaceBridge.tasks && viewItem == task",
          "group": "inline@2"
        },
        {
          "command": "workspaceBridge.compose",
          "when": "viewItem == project && view == workspaceBridge.messages",
          "group": "inline"
        },
        {
          "command": "workspaceBridge.queueHandoff",
          "when": "view == workspaceBridge.queue && viewItem == queueTask",
          "group": "inline"
        }
      ]
    }
  }
}
